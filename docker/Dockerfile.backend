# ==============================================================================
# Production Multi-Stage Dockerfile for Knowledge Base Backend (FastAPI + RAG)
# - Multi-stage build for minimized attack surface and image size
# - Runs as unprivileged non-root user (appuser UID 10001)
# - Deterministic dependencies from requirements.txt
# - Healthcheck instruction targeting /api/health/live
# ==============================================================================

# ── Stage 1: Build & Dependency Wheel Cache ──
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies for C-extensions (psycopg2, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies into /root/.local
COPY KB-main/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Stage 2: Minimal Production Runtime ──
FROM python:3.11-slim-bookworm AS runtime

WORKDIR /app

# Install minimal runtime libraries (libpq5 for PostgreSQL, curl for health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user and group (UID/GID 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

# Copy installed Python packages from builder
COPY --from=builder /root/.local /home/appuser/.local

# Set runtime environment variables
ENV PATH="/home/appuser/.local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    APP_VERSION=1.0.0 \
    ENVIRONMENT=production

# Copy application source code with non-root ownership
COPY --chown=appuser:appgroup KB-main/backend ./backend
COPY --chown=appuser:appgroup KB-main/documents ./documents
COPY --chown=appuser:appgroup KB-main/scripts ./scripts
COPY --chown=appuser:appgroup KB-main/pytest.ini .

# Create the Whoosh BM25 index directory with ownership for the non-root appuser.
# indexdir/ is gitignored (generated at runtime during ingestion), so it must NOT
# be COPYed from the build context — it is absent from a clean Git checkout.
# get_bm25_index() / ensure_index_dir() create it at runtime if missing.
RUN mkdir -p /home/appuser/.cache /app/indexdir && \
    chown -R appuser:appgroup /home/appuser/.cache /app /app/indexdir

# Switch to unprivileged user
USER 10001

# Expose backend API port
EXPOSE 8000

# Container Healthcheck (Liveness)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/live || exit 1

# Start Uvicorn ASGI server with signal propagation
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]

