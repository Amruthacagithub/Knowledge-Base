# ==============================================================================
# Production Multi-Stage Dockerfile for Knowledge Base Frontend (React + Vite)
# - Stage 1: Build static assets using Node.js 20 Alpine
# - Stage 2: Serve via NGINX 1.27 Alpine with unprivileged user
# ==============================================================================

# ── Stage 1: Node.js Builder ──
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies deterministically
COPY KB-main/frontend/package.json KB-main/frontend/package-lock.json ./
RUN npm ci

# Copy frontend source code and compile
COPY KB-main/frontend/ ./
RUN npm run build

# ── Stage 2: NGINX Static Web Server ──
FROM nginx:1.27-alpine AS runtime

# Remove default configuration and assets
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy compiled static distribution from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized reverse proxy and security configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port 80
EXPOSE 80

# Container Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/healthz || exit 1

# Start NGINX
CMD ["nginx", "-g", "daemon off;"]
